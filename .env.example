# Server Configuration
PORT=3000

# API Keys
FLIGHTRADAR24_API_KEY=your_api_key_here

# Facebook Configuration (REQUIRES ADMIN ACCESS TO PAGE - NOT RECOMMENDED)
# You cannot use Facebook API without being an admin of the page
# Leave blank to use mock data or alternative sources
FACEBOOK_ACCESS_TOKEN=

# Facebook RSS Feed (RECOMMENDED - Works without API access!)
# Create RSS feed at https://rss.app from the Facebook page
# Supports multiple feeds separated by commas for different scanner pages
# Example: FACEBOOK_RSS_URL=feed1.xml,feed2.xml,feed3.xml
FACEBOOK_RSS_URL=https://rss.app/feeds/F2oLkuuCprXqkL9R.xml

# Twitter/X Integration (Better alternative to Facebook)
# Get free API access at https://developer.twitter.com
TWITTER_HANDLE=@JeffersonCoScan
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Data Refresh Intervals (in minutes)
NEWS_REFRESH_INTERVAL=15
WEATHER_REFRESH_INTERVAL=30
FLIGHTS_REFRESH_INTERVAL=5
SCANNER_REFRESH_INTERVAL=10
TRAFFIC_REFRESH_INTERVAL=10

# Geographic Bounds for Southeastern Wisconsin
# Counties: Milwaukee, Waukesha, Racine, Kenosha, Ozaukee, Washington, Jefferson, Walworth
LATITUDE_MIN=42.5
LATITUDE_MAX=43.5
LONGITUDE_MIN=-89.0
LONGITUDE_MAX=-87.8
